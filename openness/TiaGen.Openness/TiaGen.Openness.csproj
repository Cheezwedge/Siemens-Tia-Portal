<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{7C9F2D41-2C3B-4E7A-9E51-1A6B0D6F5C10}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>TiaGen.Openness</RootNamespace>
    <AssemblyName>TiaGen.Openness</AssemblyName>
    <!-- Openness is only published for .NET Framework. V21 requires 4.8. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <!-- The Siemens assemblies are x64 only; AnyCPU fails at runtime. -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Where the Openness assemblies live. Override on the command line if your TIA
    Portal is installed elsewhere:

      msbuild TiaGen.Openness.csproj /p:TiaOpennessDir="D:\Siemens\...\PublicAPI\V21"

    The reference is compile-time only. At runtime OpennessResolver finds the
    matching assembly through the registry, which is what makes the same binary
    work on a machine with a different TIA build.
  -->
  <PropertyGroup>
    <TiaOpennessDir Condition=" '$(TiaOpennessDir)' == '' ">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21</TiaOpennessDir>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />

    <!-- The only third-party dependency. If the engineering PC has no NuGet
         access, drop Newtonsoft.Json.dll next to the exe and reference it by
         HintPath instead. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <Reference Include="Siemens.Engineering">
      <HintPath>$(TiaOpennessDir)\Siemens.Engineering.dll</HintPath>
      <!-- Never copy the Siemens assemblies next to the exe: they are resolved
           from the installation at runtime and must not be redistributed. -->
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi"
              Condition="Exists('$(TiaOpennessDir)\Siemens.Engineering.Hmi.dll')">
      <HintPath>$(TiaOpennessDir)\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- Siemens.Engineering.Hmi is a separate assembly in some installations and
       merged into Siemens.Engineering in others. HAS_HMI_ASSEMBLY lets the HMI
       code compile either way. -->
  <PropertyGroup Condition="Exists('$(TiaOpennessDir)\Siemens.Engineering.Hmi.dll')">
    <DefineConstants>$(DefineConstants);HAS_HMI_ASSEMBLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Log.cs" />
    <Compile Include="Plan.cs" />
    <Compile Include="OpennessResolver.cs" />
    <Compile Include="Runner.cs" />
    <Compile Include="Doctor.cs" />
    <Compile Include="HardwareBuilder.cs" />
    <Compile Include="SoftwareBuilder.cs" />
    <Compile Include="HmiBuilder.cs" />
    <Compile Include="Verifier.cs" />
    <Compile Include="Exporter.cs" />
  </ItemGroup>

  <Target Name="WarnMissingOpenness" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('$(TiaOpennessDir)\Siemens.Engineering.dll')">
    <Warning Text="Siemens.Engineering.dll was not found in '$(TiaOpennessDir)'. Install the TIA Portal Openness component, or pass /p:TiaOpennessDir=... pointing at the PublicAPI folder." />
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
