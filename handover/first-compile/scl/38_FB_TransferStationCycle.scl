// Generated by tiagen - do not edit.
// Edit the spec's sequence section and rebuild.

// FB_TransferStationCycle - the step sequence 'Cycle' for TransferStation.
//
// 8 steps, 1000 to 2000, returning to the first step. Idle is step 0.
//
// A request PERSISTS after its step advances, until an opposing request replaces
// it or the machine FB clears everything on losing AutoRun. That is what lets a
// clamp stay clamped for the rest of the cycle.
//
// Generated from the spec's sequence section. Editing this block is pointless -
// the next build overwrites it. Edit the step table.

FUNCTION_BLOCK "FB_TransferStationCycle"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      AutoRun : Bool;                    // sequence may advance
      Reset : Bool;                      // clear a latched timeout and the maxima
      Hold : Bool;                       // freeze on the active step
      Cond : "UDT_TransferStationCond";
   END_VAR

   VAR_OUTPUT
      Step : Int;                        // active step, 0 when idle
      BlockedById : Int;                 // condition holding the step, 0 = none
      StepTime : Time;                   // time on the active step
      Timeout : Bool;                    // latched: a step exceeded its timeout
      Complete : Bool;                   // one cycle when the last step finishes
   END_VAR

   VAR_IN_OUT
      Auto : "UDT_TransferStationAuto";            // device requests
   END_VAR

   VAR
      StepTimer : TON_TIME;
      Prev : Int;                        // step number last cycle, to reset the timer
      TimeoutLatch : Bool;
      StepTimeMax : Array[0..7] of Time;   // longest time per step, since Reset
   END_VAR

   VAR_TEMP
      vNext : Int;
      vIdx : Int;
      vPt : Time;
      vOnTimeout : Int;
      vAdvance : Bool;
      vBlocked : Int;
      vIsLast : Bool;
      vActive : Bool;
      i : Int;
   END_VAR

BEGIN
    // ==================================================================
    // 1. Entry and exit. Losing AutoRun returns to idle; the machine FB
    //    clears the Auto requests in the same cycle, so nothing is left
    //    energised by a sequence that stopped.
    // ==================================================================
    IF #Reset THEN
        #TimeoutLatch := FALSE;
        FOR #i := 0 TO 7 DO
            #StepTimeMax[#i] := T#0MS;
        END_FOR;
    END_IF;

    IF NOT #AutoRun THEN
        #Step := 0;
        #TimeoutLatch := FALSE;
    ELSIF #Step = 0 THEN
        #Step := 1000;        // WaitForPart
    END_IF;

    #vAdvance := FALSE;
    #vBlocked := 0;
    #vIsLast := FALSE;
    #vIdx := 0;
    #vPt := T#0MS;
    #vOnTimeout := 0;
    #vNext := 0;
    #Complete := FALSE;

    // ==================================================================
    // 2. The sequence. One branch per step: requests, then the transition.
    //
    //    A request PERSISTS after its step advances - that is what lets a
    //    clamp stay clamped for the rest of the cycle without repeating the
    //    request in every step. It is cleared by an opposing request, or by
    //    the machine FB when AutoRun drops. Opposing verbs cancel each other
    //    in the same step, so start and stop are never both requested.
    // ==================================================================
    CASE #Step OF
        1000:
            // ---- 1000 WaitForPart ----
            // Waiting for a part at the infeed
            #vIdx := 0;
            #Auto.Clamp_Open := FALSE;   // Clamp.close
            #Auto.Lift_Open := FALSE;   // Lift.close
            #vNext := 1100;
            IF #Cond.PartPresent AND
               #Cond.Clamp_Closed THEN
                #vAdvance := TRUE;
            ELSE
                IF #vBlocked = 0 AND NOT (#Cond.PartPresent) THEN
                    #vBlocked := 1;   // PartPresent
                END_IF;
                IF #vBlocked = 0 AND NOT (#Cond.Clamp_Closed) THEN
                    #vBlocked := 2;   // Clamp.closed
                END_IF;
            END_IF;

        1100:
            // ---- 1100 RunInfeed ----
            // Running infeed to load the part
            #vIdx := 1;
            #Auto.Infeed_Start := TRUE;   // Infeed.start
            #Auto.Infeed_Stop := FALSE;   // Infeed.start
            #vPt := T#5000MS;
            #vOnTimeout := 0;   // on_timeout: fault
            #vNext := 1200;
            IF #Cond.Infeed_Running THEN
                #vAdvance := TRUE;
            ELSE
                #vBlocked := 3;   // Infeed.running
            END_IF;

        1200:
            // ---- 1200 ClampPart ----
            // Clamping the part
            #vIdx := 2;
            #Auto.Infeed_Stop := TRUE;   // Infeed.stop
            #Auto.Infeed_Start := FALSE;   // Infeed.stop
            #Auto.Clamp_Open := TRUE;   // Clamp.open
            #vPt := T#3000MS;
            #vOnTimeout := 0;   // on_timeout: fault
            #vNext := 1300;
            IF #Cond.Clamp_Opened THEN
                #vAdvance := TRUE;
            ELSE
                #vBlocked := 4;   // Clamp.opened
            END_IF;

        1300:
            // ---- 1300 RaiseLift ----
            // Raising the transfer lift
            #vIdx := 3;
            #Auto.Lift_Open := TRUE;   // Lift.open
            #vPt := T#4000MS;
            #vOnTimeout := 0;   // on_timeout: fault
            #vNext := 1400;
            IF #Cond.Lift_Opened THEN
                #vAdvance := TRUE;
            ELSE
                #vBlocked := 5;   // Lift.opened
            END_IF;

        1400:
            // ---- 1400 TransferOut ----
            // Transferring the part to the outfeed
            #vIdx := 4;
            #Auto.Outfeed_Start := TRUE;   // Outfeed.start
            #Auto.Outfeed_Stop := FALSE;   // Outfeed.start
            #Auto.Outfeed_Speed := 30.0;   // Outfeed.speed = 30
            #vPt := T#20000MS;
            #vOnTimeout := 0;   // on_timeout: fault
            #vNext := 1500;
            IF #Cond.PartAtOutfeed THEN
                #vAdvance := TRUE;
            ELSE
                #vBlocked := 6;   // PartAtOutfeed
            END_IF;

        1500:
            // ---- 1500 ReleasePart ----
            // Releasing the clamp
            #vIdx := 5;
            #Auto.Outfeed_Stop := TRUE;   // Outfeed.stop
            #Auto.Outfeed_Start := FALSE;   // Outfeed.stop
            #Auto.Clamp_Open := FALSE;   // Clamp.close
            #vPt := T#3000MS;
            #vOnTimeout := 0;   // on_timeout: fault
            #vNext := 1600;
            IF #Cond.Clamp_Closed THEN
                #vAdvance := TRUE;
            ELSE
                #vBlocked := 2;   // Clamp.closed
            END_IF;

        1600:
            // ---- 1600 LowerLift ----
            // Lowering the transfer lift
            #vIdx := 6;
            #Auto.Lift_Open := FALSE;   // Lift.close
            #vPt := T#4000MS;
            #vOnTimeout := 0;   // on_timeout: fault
            #vNext := 2000;
            IF NOT #Cond.Lift_Opened THEN
                #vAdvance := TRUE;
            ELSE
                #vBlocked := 7;   // not Lift.opened
            END_IF;

        2000:
            // ---- 2000 CycleDone ----
            // Cycle complete - returning to start
            #vIdx := 7;
            ;   // no requests: this step only waits
            #vPt := T#30000MS;
            #vOnTimeout := 1;   // on_timeout: hold
            #vNext := 1000;
            #vIsLast := TRUE;
            IF NOT #Cond.PartAtOutfeed THEN
                #vAdvance := TRUE;
            ELSE
                #vBlocked := 8;   // not PartAtOutfeed
            END_IF;

        ELSE
            ;   // idle, or a step number nothing sets
    END_CASE;

    // ==================================================================
    // 3. Step timing. The timer resets on the cycle the step number
    //    changes, which costs one cycle of resolution and needs no
    //    per-step timer instance.
    // ==================================================================
    #vActive := #AutoRun AND #Step <> 0 AND NOT #Hold;
    #StepTimer(IN := #vActive AND #Step = #Prev,
               PT := #vPt);
    #StepTime := #StepTimer.ET;
    #Prev := #Step;

    IF #StepTime > #StepTimeMax[#vIdx] THEN
        #StepTimeMax[#vIdx] := #StepTime;
    END_IF;

    // A step with no timeout has PT = 0, and TON never sets Q for PT = 0.
    IF #vPt > T#0MS AND #StepTimer.Q THEN
        CASE #vOnTimeout OF
            0:
                #TimeoutLatch := TRUE;      // fault: hold until Reset
            2:
                #vAdvance := TRUE;          // continue: treat the timeout as the transition
            ELSE
                ;                           // hold: wait, without faulting
        END_CASE;
    END_IF;
    #Timeout := #TimeoutLatch;

    // ==================================================================
    // 4. Advance. A latched timeout or Hold freezes the step, so the
    //    requests above keep asserting and nothing half-completes.
    // ==================================================================
    IF #TimeoutLatch OR #Hold THEN
        #vAdvance := FALSE;
    END_IF;

    IF #vAdvance THEN
        #Step := #vNext;
        #Complete := #vIsLast;
    END_IF;

    #BlockedById := #vBlocked;
END_FUNCTION_BLOCK
