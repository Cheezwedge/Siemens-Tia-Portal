// Generated by tiagen - edit the machine spec, not this file.

// FB_TransferStation - the machine block for TransferStation.
//
// Sections run in this order, and the order is load bearing: safety status is
// aggregated first, the mode manager derives Enable from it, the sequence writes
// requests, the device calls act on them, and alarms are aggregated last.
//
// Every actuator is gated by the mode manager's Enable, so the safety system's
// status reaches the program in exactly one place. Called once per cycle from Main.

FUNCTION_BLOCK "FB_TransferStation"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_OUTPUT
      State : Int;                       // see FB_ModeManager states
      AutoRun : Bool;                    // auto sequence is allowed to advance
      AnyFault : Bool;                   // at least one alarm is active
   END_VAR

   VAR
      Mode : "FB_ModeManager";
      Cmd : "UDT_TransferStationCmd";              // HMI machine commands
      Auto : "UDT_TransferStationAuto";            // auto-mode requests
      Alarms : "UDT_TransferStationAlarms";        // alarm bits for the HMI
      DevicesHealthy : Bool := TRUE;     // aggregated at the end of each cycle
      Cond : "UDT_TransferStationCond";            // resolved step conditions
      Seq : "FB_TransferStationCycle";          // the generated step sequence
      // ---- device instances ----
      Infeed  : "FB_Motor";
      Clamp   : "FB_Valve";
      Lift    : "FB_Valve";
      Outfeed : "FB_Vfd";
   END_VAR

   VAR_TEMP
      vSafetyOk : Bool;
      vEnable : Bool;
      vManual : Bool;
      vReset : Bool;
   END_VAR

BEGIN
    // ==================================================================
    // 1. Safety STATUS aggregation.
    //    These contacts tell the standard program what the safety system
    //    is doing. They do not implement the safety function itself.
    // ==================================================================
    #vSafetyOk := "EStop_Ok"
                    AND "GuardDoor_Ok";

    // ==================================================================
    // 2. Mode manager. Owns Enable, the manual/auto selection and reset.
    // ==================================================================
    #Mode(SafetyOk := #vSafetyOk,
          DevicesHealthy := #DevicesHealthy,
          ReqManual := #Cmd.ReqManual,
          ReqAuto := #Cmd.ReqAuto,
          StartCmd := #Cmd.Start OR "StartPb",
          StopCmd := #Cmd.Stop,
          StopOk := "StopPb",
          ResetCmd := #Cmd.Reset OR "ResetPb",
          CycleComplete := #Seq.Complete);

    // Momentary HMI commands are consumed once the mode manager has seen them.
    #Cmd.Start := FALSE;
    #Cmd.Stop := FALSE;
    #Cmd.Reset := FALSE;
    #Cmd.ReqManual := FALSE;
    #Cmd.ReqAuto := FALSE;

    #vEnable := #Mode.Enable;
    #vManual := #Mode.ManualMode;
    #vReset := #Mode.GroupReset;
    #State := #Mode.State;
    #AutoRun := #Mode.AutoRun;

    // ==================================================================
    // 3. AUTO SEQUENCE - generated from the spec's sequence section.
    //
    //    The step logic lives in its own FB. Edit the spec and rebuild;
    //    the hand-written region below is for anything the step table
    //    cannot express, and runs after the sequencer each cycle.
    // ==================================================================
    IF NOT #AutoRun THEN
        // Auto is not running: drop every auto request so manual mode is clean.
        #Auto.Infeed_Start := FALSE;
        #Auto.Infeed_Stop := FALSE;
        #Auto.Clamp_Open := FALSE;
        #Auto.Lift_Open := FALSE;
        #Auto.Outfeed_Start := FALSE;
        #Auto.Outfeed_Stop := FALSE;
        #Auto.Outfeed_Speed := 0.0;
    END_IF;

    // ==================================================================
    // 3a. Step conditions. Every condition the sequence waits on, read
    //     from the device instances. This is the only place a status
    //     name in the spec becomes a DevIf member.
    // ==================================================================
    #Cond.PartPresent    := "PartPresent";
    #Cond.Clamp_Closed   := #Clamp.Hmi.Sts_Stopped;
    #Cond.Infeed_Running := #Infeed.Hmi.Sts_Running;
    #Cond.Clamp_Opened   := #Clamp.Hmi.Sts_Running;
    #Cond.Lift_Opened    := #Lift.Hmi.Sts_Running;
    #Cond.PartAtOutfeed  := "PartAtOutfeed";

    // ==================================================================
    // 3b. The generated step sequence.
    // ==================================================================
    // Hold reads last cycle's fault state, because alarms are aggregated in
    // section 5. One cycle late to stop advancing is harmless - the device FBs
    // have already dropped their outputs via Enable. AnyFault already includes
    // the safety status, so it is the only term needed here.
    #Seq(AutoRun := #AutoRun,
         Reset := #vReset,
         Hold := #AnyFault,
         Cond := #Cond,
         Auto := #Auto);

    // >>> BEGIN AUTO SEQUENCE >>>
    // The step table above owns the sequence. Use this region only for
    // what a step table cannot say - it runs after the sequencer, so an
    // assignment here overrides the active step's request.
    ;
    // <<< END AUTO SEQUENCE <<<

    // ==================================================================
    // 4. Device calls. One call per piece of equipment in the spec.
    // ==================================================================
    // Infeed: Infeed conveyor
    #Infeed(Enable := #vEnable,
            Interlock := TRUE,
            AutoStart := #Auto.Infeed_Start,
            AutoStop := #Auto.Infeed_Stop,
            ManualMode := #vManual,
            GroupReset := #vReset,
            RunningFb := "Infeed_Running",
            FaultFb := "Infeed_Fault",
            UseRunningFb := TRUE,
            UseFaultFb := TRUE,
            FbTimeout := T#3000MS,
            RunOut => "Infeed_Run");

    // Clamp: Part clamp
    #Clamp(Enable := #vEnable,
           Interlock := TRUE,
           AutoOpen := #Auto.Clamp_Open,
           ManualMode := #vManual,
           GroupReset := #vReset,
           OpenedFb := "Clamp_Opened",
           ClosedFb := "Clamp_Closed",
           UseOpenedFb := TRUE,
           UseClosedFb := TRUE,
           DoubleActing := TRUE,
           TravelTime := T#5000MS,
           OpenOut => "Clamp_Open",
           CloseOut => "Clamp_Close");

    // Lift: Transfer lift
    #Lift(Enable := #vEnable,
          Interlock := TRUE,
          AutoOpen := #Auto.Lift_Open,
          ManualMode := #vManual,
          GroupReset := #vReset,
          OpenedFb := "Lift_Opened",
          ClosedFb := "Lift_Closed",
          UseOpenedFb := TRUE,
          UseClosedFb := TRUE,
          DoubleActing := FALSE,
          TravelTime := T#5000MS,
          OpenOut => "Lift_Open");

    // Outfeed: Outfeed conveyor drive
    #Outfeed(Enable := #vEnable,
             Interlock := TRUE,
             AutoStart := #Auto.Outfeed_Start,
             AutoStop := #Auto.Outfeed_Stop,
             AutoSpeed := #Auto.Outfeed_Speed,
             ManualMode := #vManual,
             GroupReset := #vReset,
             RunningFb := "Outfeed_Running",
             FaultFb := "Outfeed_Fault",
             UseRunningFb := TRUE,
             UseFaultFb := TRUE,
             FbTimeout := T#5000MS,
             SpeedMin := 0.0,
             SpeedMax := 50.0,
             RawMin := 0.0,
             RawMax := 27648.0,
             SpeedRaw => "Outfeed_Speed",
             RunOut => "Outfeed_Run");

    // ==================================================================
    // 5. Alarm bits and health aggregation.
    // ==================================================================
    #Alarms.SafetyOpen := NOT #vSafetyOk;
    #Alarms.Infeed_Fault := #Infeed.Fault;
    #Alarms.Clamp_Fault := #Clamp.Fault;
    #Alarms.Lift_Fault := #Lift.Fault;
    #Alarms.Outfeed_Fault := #Outfeed.Fault;

    // Only latching / trip-level conditions block the machine.
    #AnyFault := #Alarms.SafetyOpen
                OR #Alarms.Infeed_Fault
                OR #Alarms.Clamp_Fault
                OR #Alarms.Lift_Fault
                OR #Alarms.Outfeed_Fault;
    #DevicesHealthy := NOT #AnyFault;
END_FUNCTION_BLOCK
