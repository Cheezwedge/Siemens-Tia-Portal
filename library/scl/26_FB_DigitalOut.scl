FUNCTION_BLOCK "FB_DigitalOut"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Enable : Bool := TRUE;
      Interlock : Bool := TRUE;
      AutoCmd : Bool;
      ManualMode : Bool;
      Invert : Bool := FALSE;            // TRUE for normally-closed / active-low loads
      FlashCmd : Bool := FALSE;          // TRUE = flash instead of steady on
      FlashClock : Bool;                 // wire a clock memory bit here
   END_VAR

   VAR_OUTPUT
      Out : Bool;
   END_VAR

   VAR
      Hmi : "UDT_DevIf";
      Cmd : Bool;
      Raw : Bool;
   END_VAR

BEGIN
    IF #ManualMode THEN
        IF #Hmi.Cmd_Start THEN
            #Cmd := TRUE;
        END_IF;
        IF #Hmi.Cmd_Stop THEN
            #Cmd := FALSE;
        END_IF;
    ELSE
        #Cmd := #AutoCmd;
    END_IF;

    IF NOT #Enable OR NOT #Interlock THEN
        #Cmd := FALSE;
    END_IF;

    IF #Cmd AND #FlashCmd THEN
        #Raw := #FlashClock;
    ELSE
        #Raw := #Cmd;
    END_IF;

    #Out := #Raw XOR #Invert;

    #Hmi.Sts_Cmd := #Cmd;
    #Hmi.Sts_Running := #Cmd;
    #Hmi.Sts_Interlocked := NOT #Interlock;
    #Hmi.Sts_Enabled := #Enable;
    #Hmi.Sts_ManualMode := #ManualMode;

    #Hmi.Cmd_Start := FALSE;
    #Hmi.Cmd_Stop := FALSE;
END_FUNCTION_BLOCK
